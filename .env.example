# Copy to .env (gitignored). VITE_* values are bundled into the browser, so only public values go here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
# Optional: Cloudflare Turnstile SITE key (public). Set together with TURNSTILE_SECRET in .dev.vars / wrangler secrets.
VITE_TURNSTILE_SITE_KEY=
